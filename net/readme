# 120
ysc@ysc:~$ 
sudo iptables -t nat -A POSTROUTING \
-s 192.168.1.0/24 \
-o wlan0 \
-j MASQUERADE

# 检查：
ysc@ysc:~$ 
sudo iptables -t nat -L POSTROUTING -n -v

Chain POSTROUTING (policy ACCEPT 122 packets, 7863 bytes)
