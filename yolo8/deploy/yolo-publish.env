# ============================================================
# YOLO 视频发布 —— 唯一配置文件（改这里即可）
# ============================================================
# 生效方式：./lite3-publish-ctl.sh restart <yolo|rosbridge|all>
# systemd unit 通过 EnvironmentFile= 读取同一个文件，手工/常驻行为一致。
#
# 支持 shell 注释与空行，值里不要带空格。

# ---------------- 发布模式（单/双路切换开关） ----------------
# rtmp  = 只推 RTMP（默认）
# dual  = RTMP + ROS2 图像话题（Foxglove 消费）
# ros2  = 只发 ROS2 图像话题
YOLO8_PUBLISH_MODE=rtmp

# ---------------- RTMP ----------------
# 正式流名：lite3_yolo（120 自带的是 live/lite3，两者互不影响，
# 同一台 RTMP 服务器可并存多路）
YOLO8_RTMP_URL=rtmp://172.31.68.227:1936/live/lite3_yolo
YOLO8_RTMP_BITRATE=1000000

# ---------------- 检测 ----------------
# person 置信度阈值：调低更容易检出远处/小目标，调高减少误检
YOLO8_CONF=0.4

# ---------------- ROS2 图像话题（dual/ros2 模式生效） ----------------
YOLO8_IMAGE_TOPIC=/yolo/image_annotated
YOLO8_IMAGE_QOS=reliable
YOLO8_JPEG_QUALITY=70
YOLO8_FRAME_ID=camera
YOLO8_ROS2_EVERY=3

# ---------------- rosbridge（Foxglove 通路，默认不启动） ----------------
ROSBRIDGE_PORT=9090

# ---------------- 运行时 ----------------
# headless：无桌面环境必开，会同时 patch 掉 cv2.waitKey
HEADLESS=1
# 每 N 帧打印一行 frames=/fps=/rtmp_err= 状态
YOLO8_STATUS_INTERVAL=100
